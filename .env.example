# --- database (docker compose up -d) ---
DATABASE_URL="postgres://leads:leads@localhost:5432/leads"

# --- LLM (OpenRouter). Defaults are FREE models; see `npm start -- models` ---
OPEN_ROUTER_API_KEY=your_key_here
# OPENROUTER_MODEL_SCORE=google/gemma-4-26b-a4b-it:free
# OPENROUTER_MODEL_PLAN=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_MODEL_DRAFT=nvidia/nemotron-3-super-120b-a12b:free

# --- who you are. Required for LGPD-compliant self-identification ---
SENDER_NAME=
SENDER_COMPANY=
SENDER_CNPJ=

# --- outreach guardrail ---
DAILY_SEND_CAP=40

# --- optional: Google Places, OFF by default and not needed for the core pipeline ---
# GOOGLE_MAPS_API_KEY=

# --- optional: raises the PageSpeed Insights quota (25k/day works without it) ---
# PAGESPEED_API_KEY=
